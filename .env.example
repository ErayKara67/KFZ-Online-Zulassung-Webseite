# ---------------------------------------------------------------------------
# Basis
# ---------------------------------------------------------------------------
# Öffentliche Adresse der Seite (wird für Stripe-Rücksprünge benötigt)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Zahlungen (Stripe)
# Ohne diese Werte läuft die Seite im Demo-Modus: Bestellungen werden
# gespeichert, aber es wird keine echte Zahlung ausgelöst.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# E-Mail-Versand (SMTP)
# Ohne diese Werte werden E-Mails nur in der Serverkonsole ausgegeben.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Kfz-Portal24 <service@example.de>"
ORDER_NOTIFY_EMAIL="auftraege@example.de"

# ---------------------------------------------------------------------------
# Verfügbarkeitsprüfung für Wunschkennzeichen
# Ohne diese Werte prüft die Seite nur das Format und sagt das auch so –
# eine Verfügbarkeit wird dann NICHT behauptet.
# ---------------------------------------------------------------------------
PLATE_CHECK_URL=""
PLATE_CHECK_TOKEN=""

# ---------------------------------------------------------------------------
# i-Kfz (Sofortzulassung nach Stufe 4)
# sandbox = vollständiger Ablauf ohne Behördenanbindung (Voreinstellung)
# gks     = eigene Großkundenschnittstelle beim KBA
# partner = Anbindung über einen bestehenden GKS-Teilnehmer
# ---------------------------------------------------------------------------
IKFZ_PROVIDER="sandbox"

# Nur bei IKFZ_PROVIDER="partner"
IKFZ_PARTNER_URL=""
IKFZ_PARTNER_TOKEN=""
# Zeitlimit je Anfrage an den Partner (Behördenschnittstellen antworten träge)
IKFZ_PARTNER_TIMEOUT_MS="45000"
# Gemeinsames Geheimnis für den Rückruf des Partners (/api/ikfz/callback)
IKFZ_PARTNER_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Qualifizierte elektronische Signatur der Vollmacht (§ 38 FZV)
# sandbox = Testbetrieb, rechtlich NICHT verwendbar
# partner = der Zulassungspartner stellt die QES mit (z. B. Zulio)
# qtsp    = separater qualifizierter Vertrauensdiensteanbieter
# ---------------------------------------------------------------------------
SIGNATURE_PROVIDER="sandbox"
SIGNATURE_QTSP_URL=""
SIGNATURE_QTSP_TOKEN=""

# Abruffenster des Portals in Minuten (beim Zulassungspartner erfragen)
IKFZ_ABRUFFENSTER_MINUTEN="30"

# ---------------------------------------------------------------------------
# Haendlerzugaenge (/haendler)
#
# JSON-Liste in EINER Zeile. Ohne diesen Wert ist die Anmeldung gesperrt – wer
# den Haendlerbereich oeffnen kann, sieht alle Vorgaenge mit Kundennamen,
# E-Mail-Adressen und Fahrzeugen.
#
# Code erzeugen z. B. mit: openssl rand -base64 12
#
# Beispiel (eine Zeile):
# DEALERS='[{"id":"nordstern","name":"Autohaus Nordstern","monogram":"AN","email":"verkauf@example.de","code":"HIER-LANGEN-CODE-EINSETZEN"}]'
# ---------------------------------------------------------------------------
DEALERS=""

# Eingebauten Demozugang mit dem Code "demo" freischalten.
# NUR auf dem eigenen Rechner setzen, NIEMALS auf dem Hoster – der Code ist
# allgemein bekannt. Weglassen heisst: gesperrt.
# HAENDLER_DEMO="1"

# ---------------------------------------------------------------------------
# Sachbearbeitung: Storno und Erstattung (/api/admin/erstattung)
# Mindestens 24 Zeichen, sonst ist der Endpunkt gesperrt.
# Erzeugen z. B. mit: openssl rand -hex 24
# ---------------------------------------------------------------------------
ADMIN_API_TOKEN=""

# ---------------------------------------------------------------------------
# Ablage der Auftragsdaten
#
# Auf Vercel (und jedem anderen serverlosen Hoster) ist das Dateisystem
# schreibgeschuetzt. Ohne die beiden folgenden Werte liegen Vorgaenge dort nur
# im Arbeitsspeicher und gehen beim naechsten Neustart verloren – die
# Haendleroberflaeche weist sichtbar darauf hin.
#
# Einrichten: im Vercel-Dashboard unter Storage eine KV- bzw. Upstash-Redis-
# Datenbank anlegen und mit dem Projekt verbinden. Vercel setzt die beiden
# Variablen dann selbst; danach einmal neu deployen.
# ---------------------------------------------------------------------------
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Alternativ direkt bei Upstash (gleichwertig, wird ebenfalls erkannt):
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Nur fuer den lokalen Betrieb bzw. eigene Server: Ablageordner im Dateisystem
ORDER_DATA_DIR=".data"
